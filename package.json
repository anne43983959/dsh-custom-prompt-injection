{
  "name": "dsh-custom-prompt-injection",
  "version": "1.2.0",
  "description": "自定义提示词注入（Custom Prompt Injection）—— 给 DSH 加一套可切换的系统提示词载荷：中文档 / 英文档 / 不注入，附三色状态条、跨重启档位记忆与轮次级生效日志。载荷是随包分发的提示词文本，安装不需要读它；插件不联网、不改 DSH 安装目录、不写 home 之外的位置。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "prompts",
    "scripts",
    "install.mjs",
    "uninstall.mjs",
    "install.ps1",
    "uninstall.ps1",
    "install.sh",
    "uninstall.sh",
    "install.bat"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/check.mjs",
    "smoke:host": "node scripts/smoke-injection-host.mjs",
    "ledger": "node scripts/ledger.mjs",
    "score:session": "node scripts/score-session.mjs",
    "plugin:install": "node install.mjs",
    "plugin:uninstall": "node uninstall.mjs"
  },
  "dsh": {
    "id": "dsh-custom-prompt-injection",
    "name": "自定义提示词注入",
    "permissions": "系统提示词注入, 客户端状态条",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "runtime": ">=0.1.1-rc.1 <0.3.0"
    }
  }
}
